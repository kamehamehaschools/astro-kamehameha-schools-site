      <script
        is:inline
        type="text/javascript"
        src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollSmoother.min.js"
      ></script>
      <script
        is:inline
        type="text/javascript"
        src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollToPlugin.min.js"
      ></script>

      <!--DIVIDER-->
      <script is:inline type="text/javascript">
        // ScrollSmoother setup
        const smoother = ScrollSmoother.create({
          wrapper: "#smooth-wrapper",
          content: "#smooth-content",
          smooth: 1,
          effects: true,
        });
      </script>

      <script is:inline type="text/javascript">
        // Fade-in animations
        [
          {
            selector: ".fadein",
            from: { autoAlpha: 0 },
            to: { duration: 2, autoAlpha: 1, delay: 0.2 },
          },
          {
            selector: ".fadein-intro",
            from: { autoAlpha: 0, y: 70 },
            to: { duration: 2, autoAlpha: 1, y: 0, delay: 0.5 },
          },
          {
            selector: ".fadein-intro-sub",
            from: { autoAlpha: 0, y: 70 },
            to: { duration: 2, autoAlpha: 1, y: 0, delay: 0.5 },
          },
        ].forEach(({ selector, from, to }) => {
          gsap.utils.toArray(selector).forEach((el) => {
            const anim = gsap.fromTo(el, from, to);
            ScrollTrigger.create({
              trigger: el,
              animation: anim,
              toggleActions: "play none none none",
              once: true,
            });
          });
        });
      </script>

      <!--DIVIDER-->
      <link href="https://use.typekit.net/uva8yew.css" rel="stylesheet" />
      <script is:inline type="text/javascript">
        document.addEventListener("DOMContentLoaded", () => {
          gsap.registerPlugin(ScrollTrigger, ScrollSmoother, ScrollToPlugin);

          // Hide sticky nav on load
          const navbarSticky = document.querySelector(".navbar-sticky");
          if (navbarSticky) navbarSticky.classList.add("hidden");

          // Scroll nav links
          gsap.utils.toArray(".nav-link").forEach((button) => {
            button.addEventListener("click", (e) => {
              e.preventDefault();
              const id = button.getAttribute("href");
              const navOffset = getNavOffset();

              if (id === "#top") {
                smoother.scrollTo(0, true);
              } else {
                const targetElem = document.querySelector(id);
                if (targetElem) {
                  const targetY =
                    smoother.offset(targetElem, "top top") - navOffset;
                  smoother.scrollTo(targetY, true);
                }
              }
              // close mobile nav after click
              $(".navbar .collapse").collapse("hide");
            });
          });

          function getNavOffset() {
            return window.innerWidth <= 991
              ? document.querySelector(".navbar-start").offsetHeight
              : document.querySelector(".navbar").offsetHeight;
          }

          // Scroll navbar behavior
          window.addEventListener("scroll", () => {
            const scrolled = window.scrollY > 144;
            if (navbarSticky) {
              navbarSticky.classList.toggle("visible", scrolled);
              navbarSticky.classList.toggle("hidden", !scrolled);
            }
            document
              .querySelector(".navbar")
              .classList.toggle("scrolled", scrolled);
          });

          // Rotate on scroll animations
          document.querySelectorAll(".edu-kalo-animate").forEach((elem) => {
            const rotation = parseFloat(elem.dataset.rotation) || 0;
            const duration = parseFloat(elem.dataset.duration) || 2;

            ScrollTrigger.create({
              trigger: elem,
              start: "top 80%",
              onEnter: () => {
                elem.classList.add("animated");
                gsap.to(elem, {
                  rotation,
                  duration,
                  transformOrigin: "50% 50%",
                });
              },
              once: true,
            });
          });

          // Example static scroll trigger for background image (if needed)
          ScrollTrigger.create({
            trigger: ".edu-kalo-back",
            start: "top 80%",
            onEnter: () => {
              gsap.to(".edu-kalo-back", {
                rotation: 25,
                duration: 2.5,
                transformOrigin: "50% 50%",
              });
            },
            once: true,
          });

          // Load hash target if present on page load
          const urlHash = window.location.hash;
          if (urlHash) {
            const scrollElem = document.querySelector(urlHash);
            if (scrollElem) {
              gsap.to(smoother, {
                scrollTop: smoother.offset(scrollElem, "top top"),
                duration: 1,
                delay: 0.5,
              });
            }
          }
        });
      </script>
    </main>
  </div>
</div>
