---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
---

<Header />
<style>
  /*Smooth*/
  body {
    overscroll-behavior: none;
    overflow-x: hidden;
    font-family: "Ringside Regular SSm A", "Ringside Regular SSm B";
    color: #000000;
  }
  #smooth-wrapper {
    overflow: hidden !important;
    position: fixed;
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }
  #smooth-content {
    overflow: visible;
    width: 100%;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.07) 2px, transparent 2px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 2px, transparent 2px),
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size:
      100px 100px,
      100px 100px,
      20px 20px,
      20px 20px;
    background-position:
      -2px -2px,
      -2px -2px,
      -1px -1px,
      -1px -1px;
    padding: 0;
  }
  @media (max-width: 767px) {
    #smooth-content {
      padding: 0;
    }
  }
  /*Default Header & Footer*/
  .typicalCont,
  .topfooter,
  .footer,
  .typical {
    display: none;
  }
  .header {
    position: relative;
  }
  .header #___gcse_0 {
    display: none;
  }
  .topfooter-alt {
    position: relative;
    padding: 150px 0px 60px;
    float: none;
  }
  .topfooter-alt .socialIcons ul li a {
    width: 40px;
  }
  .topfooter-alt .socialIcons {
    margin: 20px 0 30px;
  }
  .footer-alt {
    background-color: #19325a;
    padding: 30px 0px;
    bottom: 0;
    position: absolute;
  }
</style>

