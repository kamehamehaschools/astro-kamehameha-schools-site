---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteTitle = "Home | Kamehameha Schools";
---

<BaseLayout siteTitle={siteTitle}>
<section class="main main99 boxs">
  <div id="wwwHomepageHero">
    <!-- start sf -->
    <style type="text/css">
      video {
        -o-object-fit: cover;
        object-fit: cover;
        position: absolute;
        height: 533px;
        width: 100%;
        top: 0;
        left: 0;
        z-index: -1;
      }
      .homeslider h1,
      .homeslider p {
        color: #ffffff;
      }
      .homeslider ul {
        float: none;
      }
    </style>
    <div class="patternboximg type-right"></div>
    <div class="home_inn homeindex slick boxs">
      <div class="homeslider boxs" style="height: 533px;">
        <div class="video-container">
          <div class="callout boxs">
            <h1>Hānai&nbsp;i&nbsp;ke&nbsp;keiki, ola&nbsp;ka&nbsp;lāhui</h1>
            <p>Nurture the child and the lāhui&nbsp;thrives</p>
            <ul></ul>
          </div>
          <!-- end callout -->
          <video
            src="https://www.ksbe.edu/assets/video/hanai-video.mp4"
            autoplay
            loop
            muted
            disablepictureinpicture
            playsinline></video>
        </div>
        <!-- end container -->
      </div>
      <!-- end homeslider -->
    </div>
    <!-- end home_inn -->
  </div>
  <!-- end sf -->
</section>
<!-- end main -->

<div class="explore boxs" style="background-color: #4682f0; color: #ffffff;">
