<style>
  .lahaina-section {
    background-image:
      linear-gradient(135deg, rgba(17, 37, 10, 1), rgba(17, 37, 10, 0.25)),
      url("https://www.ksbe.edu/assets/site/special_section/lahaina/lahaina-map-parallax-bg-1366x2610px.webp");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    /*min-height: 30vh;*/
  }
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .lahaina-section {
      background-attachment: scroll;
      background-size: cover;
      background-position: center;
      /*min-height: 30vh;*/
    }
  }
  .lahaina-section a {
    color: #ededed;
    text-decoration: none;
    border-bottom: 1px dotted #ffffff;
  }
  .lahaina-section a:hover {
    color: #fff;
    border-bottom: 1px solid #ffffff;
  }
</style>
<div class="clearfix"></div>
<section class="lahaina-section py-5">
  <div class="container">
    <div class="row m-0">
      <div
        class="col-md-8 text-white ps-0 pt-3 pb-4 py-md-5 pe-2 order-2 order-sm-1"
      >
        <p class="small text-uppercase">Lahaina Restoration</p>
        <h2 class="text-white">Hālau Lahaina, malu i ka ‘ulu</h2>
        <p>
          A holistic vision for restoring abundance, stewardship and resilience
          in Lahaina.
        </p>
        <a href="/lahaina">Discover the latest</a>
      </div>
      <div
        class="col-md-4 p-0 pt-3 pb-2 pt-sm-2 px-sm-2 pb-sm-4 py-md-5 order-1 order-sm-2"
      >
